# Gmail (IMAP + App Password — myaccount.google.com/apppasswords, 2FA gerekir)
GMAIL_IMAP_USER=
GMAIL_APP_PASSWORD=
EXPENSE_USER_ID=

# Outlook (Microsoft Graph OAuth — npm run get-token-outlook ile üretilir)
MS_CLIENT_ID=
MS_REFRESH_TOKEN=
EXPENSE_USER_ID_2=

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Ekstre kontrolü: "true" ise güvenli düzeltmeler (eksik işlem ekleme, taksite
# çevirme, taksit tutarı düzeltme) kendiliğinden uygulanır. Boş bırakılırsa
# rapor modu: bulgular kaydedilip bildirilir, harcamalara dokunulmaz.
STATEMENT_AUTO_APPLY=

# Push bildirimleri (opsiyonel — boş bırakılırsa özellik sessizce devre dışı kalır)
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_AUTH_KEY=
APNS_BUNDLE_ID=
